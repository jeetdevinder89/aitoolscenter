{
  "name": "aitoolscenter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run links:check && npm run social:cards && npm run sitemap:generate && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seo:check": "node scripts/seo-healthcheck.mjs https://www.aitoolscenter.in",
