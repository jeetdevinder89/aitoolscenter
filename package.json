    "links:uptime:strict": "node scripts/check-external-links.mjs --strict",
    "social:cards": "node scripts/generate-social-cards.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "news:update": "node scripts/update-ai-news.mjs",
    "toolkit:pdf": "node scripts/generate-toolkit-pdf.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@supabase/supabase-js": "^2.43.4",
