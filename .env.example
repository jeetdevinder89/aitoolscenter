# Supabase project URL.
# Example:
# SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=

# Supabase service role key used by Vercel API routes.
# Keep this server-side only. Do not expose it in VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Optional newsletter email settings using Python SMTP in /api/newsletter.py.
# Example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@yourdomain.com
# SMTP_PASSWORD=app_or_smtp_password
# SMTP_USE_TLS=true
# NEWSLETTER_FROM_EMAIL=AIToolsCenter <newsletter@yourdomain.com>
# NEWSLETTER_REPLY_TO_EMAIL=support@yourdomain.com
# SITE_URL=https://aitoolscenter.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_REPLY_TO_EMAIL=
SITE_URL=

# Optional Google AdSense client ID for in-page ad units.
# Example: VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
VITE_ADSENSE_CLIENT_ID=

# Optional Amazon Associates store ID used to auto-append `?tag=` to Amazon links.
# Example for Amazon India: VITE_AMAZON_ASSOCIATE_TAG=aitoolscenter-21
VITE_AMAZON_ASSOCIATE_TAG=aitoolscenter-21

# Optional Meta Pixel ID for Facebook/Instagram ads conversion tracking.
# Example: VITE_META_PIXEL_ID=123456789012345
VITE_META_PIXEL_ID=

# Toggle visible Facebook ad placeholders on the landing page.
# Example: VITE_ENABLE_FACEBOOK_AD_PLACEHOLDERS=true
VITE_ENABLE_FACEBOOK_AD_PLACEHOLDERS=true

# Affiliate tracking links — replace with your personal tracking URLs after signing up.
VITE_AFFILIATE_NOTION=
VITE_AFFILIATE_RUNWAY=
VITE_AFFILIATE_CURSOR=
VITE_AFFILIATE_TABNINE=
VITE_AFFILIATE_PERPLEXITY=
VITE_AFFILIATE_MAKE=
VITE_AFFILIATE_ZAPIER=
VITE_AFFILIATE_COPILOT=
